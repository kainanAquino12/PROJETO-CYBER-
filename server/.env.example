# ── Config do servidor (API de coleta) — TEMPLATE ───────────────────────────
# Copie este arquivo para .env e ajuste os valores.

# Porta local (no Render/Railway a porta e injetada automaticamente).
PORT=3000

# Enriquecer o IP com geolocalizacao via ip-api.com (true/false).
GEO_ENABLED=true

# Chave de acesso ao painel /dashboard e a /api/visits. TROQUE por algo seu!
DASHBOARD_KEY=defina-uma-chave-secreta

# Origem permitida no CORS (front em outro dominio). Vazio = qualquer origem.
ALLOW_ORIGIN=

# Pasta do front-end. Padrao: pasta-pai do server/.
FRONT_DIR=..
