# ── Config do servidor (API de coleta) — TEMPLATE ───────────────────────────
# Copie este arquivo para .env e ajuste os valores.

# Porta local (no Render/Railway a porta e injetada automaticamente).
PORT=3000

# Enriquecer o IP com geolocalizacao via ip-api.com (true/false).
GEO_ENABLED=true

# Acesso ao painel /dashboard: agora e por LOGIN (e-mail autorizado + senha),
# nao mais por chave. Os e-mails autorizados ficam na lista ALLOWED_EMAILS
# dentro de server.js. As senhas sao cadastradas no primeiro acesso e
# guardadas (com hash) em server/data/auth.json.

# Origem permitida no CORS (front em outro dominio). Vazio = qualquer origem.
ALLOW_ORIGIN=

# Pasta do front-end. Padrao: pasta-pai do server/.
FRONT_DIR=..
